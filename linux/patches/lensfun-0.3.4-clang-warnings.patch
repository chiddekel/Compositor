+    if (mina != float (INT_MAX) && !MinAperture)
         MinAperture = mina;
-    if (maxa != INT_MIN && !MaxAperture)
+    if (maxa != float (INT_MIN) && !MaxAperture)
         MaxAperture = maxa;
 
     if (!MaxFocal)
