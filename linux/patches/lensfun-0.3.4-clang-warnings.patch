# clang: CMake 2.8.12 minimum (deprecated in CMake 4), memset on non-trivially copyable structs, int sentinels
# compared as floats.
diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,5 +1,5 @@
 # require at least cmake 2.8.12
-CMAKE_MINIMUM_REQUIRED(VERSION 2.8.12 FATAL_ERROR )
+CMAKE_MINIMUM_REQUIRED(VERSION 3.10 FATAL_ERROR )
 
 # path for helper modules
 set(CMAKE_MODULE_PATH "${CMAKE_MODULE_PATH}" "${CMAKE_SOURCE_DIR}/cmake/modules")
diff -ruN a/libs/lensfun/camera.cpp b/libs/lensfun/camera.cpp
--- a/libs/lensfun/camera.cpp
+++ b/libs/lensfun/camera.cpp
@@ -13,7 +13,8 @@
     // lfLens instances used for searches could not be matched against database
     // lenses easily.  If you need defaults for database tags, set them when
     // reading the database.
-    memset (this, 0, sizeof (*this));
+    // Zero the plain C fields; the struct has no virtual table, so its raw storage is all fields.
+    memset (static_cast<void *> (this), 0, sizeof (*this));
 }
 
 lfCamera::~lfCamera ()
diff -ruN a/libs/lensfun/lens.cpp b/libs/lensfun/lens.cpp
