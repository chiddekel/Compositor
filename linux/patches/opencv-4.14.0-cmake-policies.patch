# CMake 4: minimum 3.10, NEW for the FindCUDA/FindPython policies (neither CUDA nor Python bindings are built),
# CMP0218 NEW for the variable dump.
diff -ruN a/cmake/OpenCVMinDepVersions.cmake b/cmake/OpenCVMinDepVersions.cmake
--- a/cmake/OpenCVMinDepVersions.cmake
+++ b/cmake/OpenCVMinDepVersions.cmake
@@ -1,5 +1,5 @@
 if(NOT DEFINED MIN_VER_CMAKE)
-  set(MIN_VER_CMAKE 3.7)
+  set(MIN_VER_CMAKE 3.10)
 endif()
 set(MIN_VER_CUDA 6.5)
 set(MIN_VER_CUDNN 7.5)
diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -84,12 +84,16 @@
   cmake_policy(SET CMP0091 NEW) # CMake 3.15+: leave MSVC runtime selection out of default CMAKE_<LANG>_FLAGS_<CONFIG> flags
 endif()
 
+if(POLICY CMP0218)
+  cmake_policy(SET CMP0218 NEW)  # CMake 4.4+: CMAKE_WARN_DEPRECATED is not read as a variable (the variable dump reads every one).
+endif()
+
 if(POLICY CMP0146)
-  cmake_policy(SET CMP0146 OLD)  # CMake 3.27+: use CMake FindCUDA if available.
+  cmake_policy(SET CMP0146 NEW)  # CMake 3.27+: no FindCUDA (CUDA is not built here).
 endif()
 
 if(POLICY CMP0148)
-  cmake_policy(SET CMP0148 OLD)  # CMake 3.27+: use CMake FindPythonInterp and FindPythonLib if available.
+  cmake_policy(SET CMP0148 NEW)  # CMake 3.27+: no FindPythonInterp/FindPythonLibs (no Python bindings here).
 endif()
 
 #
