#version 450
#extension GL_GOOGLE_include_directive : require
#include "warp_precision.glsl"
layout(local_size_x=16,local_size_y=16) in;
layout(push_constant) uniform Parameters { uint width; uint height; float strength; uint padding; } u;
layout(std430,binding=0) readonly buffer Under { vec4 under[]; };
layout(std430,binding=1) buffer Carried { vec4 carried[]; };
layout(std430,binding=2) readonly buffer Weights { float weights[]; };
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    if (p.x>=u.width || p.y>=u.height) return;
    uint i=p.y*u.width+p.x;
    if (weights[i]<=0) return;
    // Preserve the upstream order of arithmetic and the unquantized carried color.
    precise vec4 delta=carried[i]-under[i];
    precise float blend=weights[i]*u.strength;
    precise vec4 painted=under[i]+delta*blend;
    carried[i]=painted;
}
